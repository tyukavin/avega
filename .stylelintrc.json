{
    "extends": ["stylelint-config-standard-scss"],
    "ignoreFiles": ["src/scss/base/_01_normalize.scss"],
    "rules": {
        "selector-class-pattern": [
            "^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z][a-z0-9]*(-[a-z0-9]+)*)?(--[a-z][a-z0-9]*(-[a-z0-9]+)*)?$",
            { "resolveNestedSelectors": true }
        ]
    }
}
