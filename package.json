{
    "name": "web-startpack",
    "version": "2.0.0",
    "description": "Modern Gulp starter for static HTML and PHP markup projects",
    "private": true,
    "scripts": {
        "start": "gulp dev",
        "html": "gulp dev",
        "php": "gulp dev:php",
        "clean": "gulp clean",
        "build": "gulp build",
        "deploy": "gulp deploy",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint:js": "eslint gulpfile.js tasks src/js",
        "lint:css": "stylelint \"src/**/*.scss\"",
        "lint:html": "html-validate \"build/**/*.html\"",
        "lint": "npm run lint:js && npm run lint:css",
        "check": "npm run format:check && npm run lint && npm run build && npm run lint:html"
    },
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "autoprefixer": "^10.5.3",
        "browser-sync": "^3.0.4",
        "esbuild": "^0.28.1",
        "eslint": "^10.7.0",
        "globals": "^17.7.0",
        "gulp": "^5.0.1",
        "gulp-file-include": "^2.3.0",
        "html-validate": "^11.5.6",
        "postcss": "^8.5.19",
        "prettier": "^3.9.5",
        "sass": "^1.101.0",
        "sharp": "^0.35.3",
        "ssh2-sftp-client": "^12.1.1",
        "stylelint": "^17.14.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "svgo": "^4.0.2",
        "wawoff2": "^2.0.1"
    },
    "browserslist": [
        "defaults",
        "not dead"
    ],
    "engines": {
        "node": ">=24.8.0",
        "npm": ">=11"
    },
    "volta": {
        "node": "24.15.0",
        "npm": "11.12.1"
    },
    "packageManager": "npm@11.12.1"
}
